---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene3D from '../components/Scene3D.astro';

---

<BaseLayout>
  <main>
    <!-- 1. NAVBAR -->
    <header id="navbar" class="navbar">
      <div class="container navbar__inner">
        <a href="/" class="navbar__logo">
          LUMU<span class="dot">.</span>
        </a>
        <nav class="navbar__links">
          <a href="#services">Services</a>
          <a href="#process">Fonctionnement</a>
          <a href="#zones">Zones</a>
          <a href="#contact">Contact</a>
        </nav>
        <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
  <span></span>
  <span></span>
</button>
        <button class="theme-toggle" id="theme-toggle" aria-label="Changer de thème">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>
        <a href="#contact" class="btn btn-primary navbar__cta" data-cursor-text="Devis">Devis</a>
      </div>
    </header>
     <!-- MENU MOBILE -->
<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-menu__nav">
    <a href="#services" data-menu-link>Services</a>
    <a href="#process" data-menu-link>Fonctionnement</a>
    <a href="#zones" data-menu-link>Zones</a>
    <a href="#faq" data-menu-link>FAQ</a>
    <a href="#contact" data-menu-link>Contact</a>
  </nav>
  <div class="mobile-menu__footer">
    <a href="https://wa.me/243858814961" target="_blank" rel="noopener" class="btn btn-primary">
      WhatsApp
    </a>
    <button class="theme-toggle theme-toggle--mobile" id="theme-toggle-mobile" aria-label="Changer de thème">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</div>

    <!-- 2. HERO -->
    <section id="hero" class="section hero">
      <Scene3D />
      <div class="container">
        <span class="section-label">Livraison à Kinshasa</span>
        <h1>Votre colis,<br />notre mission<span class="dot">.</span></h1>
        <p class="hero__sub">Rapide, fiable, partout dans la ville.</p>
        <div class="hero__actions">
          <a href="#contact" class="btn btn-primary" data-cursor-text="Démarrer">Demander un devis</a>
<a href="#services" class="btn btn-outline" data-cursor-text="Voir">Nos services</a>
        </div>
      </div>
    </section>

    <!-- 3. MARQUEE -->
    <section class="marquee">
      <div class="marquee__track">
        <span>LIVRAISON EXPRESS • KINSHASA • 24H • FIABLE • </span>
        <span>LIVRAISON EXPRESS • KINSHASA • 24H • FIABLE • </span>
      </div>
    </section>

    <!-- 4. SERVICES -->
<section id="services" class="section services">
  <div class="container">
    <div class="section-head">
      <span class="section-label">Nos services</span>
      <h2>Ce que nous livrons<span class="dot">.</span></h2>
      <p class="section-intro">
        Une solution pour chaque besoin. Rapide quand il faut, fiable toujours.
      </p>
    </div>

    <div class="services__grid">
      <article class="service-card" data-service data-cursor-text="Explorer">
        <div class="service-card__number">01</div>
        <div class="service-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3>Express 24h</h3>
        <p>Livraison urgente dans Kinshasa en moins de 24 heures. Priorité absolue.</p>
        <div class="service-card__arrow">→</div>
      </article>

      <article class="service-card" data-service data-cursor-text="Explorer">
        <div class="service-card__number">02</div>
        <div class="service-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
        <h3>Standard</h3>
        <p>Livraison planifiée sous 48 à 72h. Le bon équilibre entre prix et délai.</p>
        <div class="service-card__arrow">→</div>
      </article>

      <article class="service-card" data-service data-cursor-text="Explorer">
        <div class="service-card__number">03</div>
        <div class="service-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
        </div>
        <h3>Courses & Repas</h3>
        <p>Vos courses, repas ou achats récupérés et livrés chez vous. Sans effort.</p>
        <div class="service-card__arrow">→</div>
      </article>

      <article class="service-card" data-service data-cursor-text="Explorer">
        <div class="service-card__number">04</div>
        <div class="service-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </div>
        <h3>Documents & Colis Pro</h3>
        <p>Documents sensibles et colis professionnels. Confidentialité garantie.</p>
        <div class="service-card__arrow">→</div>
      </article>
    </div>
  </div>
</section>

    <!-- 5. PROCESS -->
<section id="process" class="section process">
  <div class="container">
    <div class="section-head">
      <span class="section-label">Comment ça marche</span>
      <h2>En 4 étapes simples<span class="dot">.</span></h2>
      <p class="section-intro">
        De votre commande à la livraison, un process clair et rapide.
      </p>
    </div>

    <div class="process__timeline">
      <div class="process__line">
        <div class="process__line-progress"></div>
      </div>

      <div class="process__steps">
        <div class="process-step" data-step>
          <div class="process-step__marker">
            <span>01</span>
          </div>
          <h3>Vous commandez</h3>
          <p>Appelez-nous, écrivez sur WhatsApp ou remplissez le formulaire. Dites-nous quoi, où, quand.</p>
        </div>

        <div class="process-step" data-step>
          <div class="process-step__marker">
            <span>02</span>
          </div>
          <h3>Nous collectons</h3>
          <p>Un livreur LUMU passe récupérer votre colis à l'adresse indiquée, dans l'heure.</p>
        </div>

        <div class="process-step" data-step>
          <div class="process-step__marker">
            <span>03</span>
          </div>
          <h3>Nous livrons</h3>
          <p>Votre colis est acheminé en toute sécurité vers sa destination, dans Kinshasa.</p>
        </div>

        <div class="process-step" data-step>
          <div class="process-step__marker">
            <span>04</span>
          </div>
          <h3>Vous confirmez</h3>
          <p>Vous recevez une confirmation de livraison. Simple, rapide, transparent.</p>
        </div>
      </div>
    </div>
  </div>
</section>

    <!-- 6. ZONES -->
<section id="zones" class="section zones">
  <div class="container">
    <div class="section-head">
      <span class="section-label">Zones couvertes</span>
      <h2>Toute la ville de Kinshasa<span class="dot">.</span></h2>
      <p class="section-intro">
        Nos livreurs sillonnent les 24 communes. Votre adresse est forcément sur notre route.
      </p>
    </div>

    <div class="zones__grid">
      {[
        'Gombe', 'Limete', 'Lingwala', 'Kasa-Vubu',
        'Ngaliema', 'Bandalungwa', 'Matete', 'Lemba',
        'Ngaba', 'Kintambo', 'Kinshasa', 'Barumbu',
      ].map((zone, i) => (
        <div class="zone-item" data-zone data-cursor-text="Voir zone">
          <span class="zone-item__index">{String(i + 1).padStart(2, '0')}</span>
          <span class="zone-item__name">{zone}</span>
          <span class="zone-item__arrow">↗</span>
        </div>
      ))}
    </div>
  </div>
</section>

    <!-- 7. STATS -->
<section id="stats" class="section stats">
  <div class="container">
    <div class="stats__grid">
      <div class="stat" data-stat>
        <div class="stat__value">
          <span data-count="5000">0</span><span class="stat__plus">+</span>
        </div>
        <div class="stat__label">Colis livrés</div>
      </div>

      <div class="stat" data-stat>
        <div class="stat__value">
          <span data-count="300">0</span><span class="stat__plus">+</span>
        </div>
        <div class="stat__label">Clients réguliers</div>
      </div>

      <div class="stat" data-stat>
        <div class="stat__value">
          <span data-count="24">0</span>
        </div>
        <div class="stat__label">Communes couvertes</div>
      </div>

      <div class="stat" data-stat>
        <div class="stat__value">
          <span data-count="24">0</span><span class="stat__plus">h</span>
        </div>
        <div class="stat__label">Délai moyen</div>
      </div>
    </div>
  </div>
</section>
   <!-- 8. TÉMOIGNAGES -->
<section id="testimonials" class="section testimonials">
  <div class="container">
    <div class="section-head">
      <span class="section-label">Témoignages</span>
      <h2>Ils nous font confiance<span class="dot">.</span></h2>
    </div>

    <div class="testimonials__grid">
      <article class="testimonial" data-testimonial>
        <div class="testimonial__quote">"</div>
        <p class="testimonial__text">
          Colis récupéré en 30 minutes et livré dans l'heure. Franchement, je ne pensais pas que c'était possible à Kinshasa.
        </p>
        <div class="testimonial__author">
          <div class="testimonial__avatar">NN</div>
          <div>
            <div class="testimonial__name">Nelly N.</div>
            <div class="testimonial__role">E-commerçante, Gombe</div>
          </div>
        </div>
      </article>

      <article class="testimonial" data-testimonial>
        <div class="testimonial__quote">"</div>
        <p class="testimonial__text">
          Je commande mes courses chaque semaine. Toujours à l'heure, toujours polis. LUMU est devenu indispensable pour moi.
        </p>
        <div class="testimonial__author">
          <div class="testimonial__avatar">DT</div>
          <div>
            <div class="testimonial__name">David T.</div>
            <div class="testimonial__role">Cadre bancaire, Limete</div>
          </div>
        </div>
      </article>

      <article class="testimonial" data-testimonial>
        <div class="testimonial__quote">"</div>
        <p class="testimonial__text">
          On utilise LUMU pour tous nos documents professionnels. Confidentiel, rapide, fiable. Un vrai partenaire.
        </p>
        <div class="testimonial__author">
          <div class="testimonial__avatar">BN</div>
          <div>
            <div class="testimonial__name">Bibi N.</div>
            <div class="testimonial__role">Avocate, Ngaliema</div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

   <!-- 9. FAQ -->
<section id="faq" class="section faq">
  <div class="container">
    <div class="section-head">
      <span class="section-label">FAQ</span>
      <h2>Questions fréquentes<span class="dot">.</span></h2>
    </div>

    <div class="faq__list">
      {[
        {
          q: 'Quels sont vos délais de livraison ?',
          a: 'En Express 24h, votre colis est livré le jour même ou le lendemain. En Standard, comptez 48 à 72h. Les délais exacts dépendent de la distance entre l\'adresse de collecte et de livraison.',
        },
        {
          q: 'Quelles zones de Kinshasa couvrez-vous ?',
          a: 'Nous couvrons les 24 communes de Kinshasa, dont Gombe, Limete, Ngaliema, Lemba, Matete, Bandalungwa, Kintambo et bien d\'autres. Si vous avez un doute sur votre zone, écrivez-nous sur WhatsApp.',
        },
        {
          q: 'Comment suivre mon colis ?',
          a: 'Dès que votre colis est pris en charge, vous recevez un message WhatsApp avec le nom du livreur. Vous pouvez le contacter directement à tout moment pour connaître la position de votre colis.',
        },
        {
          q: 'Quels types de colis transportez-vous ?',
          a: 'Documents, petits colis, courses alimentaires, repas, achats en boutique, matériel professionnel. Nous ne transportons pas de produits illégaux, dangereux ou périssables non emballés.',
        },
        {
          q: 'Comment se passe le paiement ?',
          a: 'Le paiement se fait à la livraison, en espèces ou par Mobile Money (M-Pesa, Orange Money, Airtel Money). Pour les clients professionnels réguliers, une facturation mensuelle est possible.',
        },
        {
          q: 'Puis-je annuler une commande ?',
          a: 'Oui, tant que le colis n\'a pas été collecté. Contactez-nous immédiatement sur WhatsApp. Une fois le colis en route, l\'annulation n\'est plus possible.',
        },
      ].map((item) => (
        <div class="faq-item" data-faq>
          <button class="faq-item__trigger" type="button">
            <span class="faq-item__question">{item.q}</span>
            <span class="faq-item__icon">
              <span></span>
              <span></span>
            </span>
          </button>
          <div class="faq-item__content">
            <div class="faq-item__content-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

   <!-- 10. CONTACT -->
<section id="contact" class="section contact">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__intro">
        <span class="section-label">Contact</span>
        <h2>Parlons de votre livraison<span class="dot">.</span></h2>
        <p class="section-intro">
          Remplissez le formulaire, on vous répond en quelques minutes sur WhatsApp.
        </p>

        <div class="contact__infos">
          <div class="contact__info">
            <span class="contact__info-label">WhatsApp</span>
            <a href="https://wa.me/243858814961" target="_blank" rel="noopener">
              +243 858 814 961
            </a>
          </div>
          <div class="contact__info">
            <span class="contact__info-label">Email</span>
            <a href="mailto:contact@lumu.cd">contact@lumu.cd</a>
          </div>
          <div class="contact__info">
            <span class="contact__info-label">Horaires</span>
            <span>Lun – Sam · 7h – 21h</span>
          </div>
        </div>
      </div>

      <form class="contact__form" id="contact-form" novalidate>
        <div class="form-field">
          <label for="name">Nom complet</label>
          <input type="text" id="name" name="name" required placeholder="Ex : Nicaise Buhanda" />
        </div>

        <div class="form-field">
          <label for="phone">Téléphone</label>
          <input type="tel" id="phone" name="phone" required placeholder="Ex : +243 XXX XXX XXX" />
        </div>

        <div class="form-field">
          <label for="address">Adresse de collecte</label>
          <input type="text" id="address" name="address" required placeholder="Commune, quartier, avenue..." />
        </div>

        <div class="form-field">
          <label for="message">Détails de la livraison</label>
          <textarea id="message" name="message" rows="4" required placeholder="Que doit-on livrer, et où ?"></textarea>
        </div>

        <button type="submit" class="btn btn-primary contact__submit" data-cursor-text="Envoyer">
          Envoyer sur WhatsApp
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>

        <p class="form-hint">
          Ou écrivez-nous directement à
          <a href="mailto:contact@lumu.cd">contact@lumu.cd</a>
        </p>
      </form>
    </div>
  </div>
</section>

   <!-- 11. FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo">LUMU<span class="dot">.</span></a>
        <p>Votre colis, notre mission.</p>
      </div>

      <div class="footer__col">
        <h4>Navigation</h4>
        <a href="#services">Services</a>
        <a href="#process">Fonctionnement</a>
        <a href="#zones">Zones</a>
        <a href="#faq">FAQ</a>
      </div>

      <div class="footer__col">
        <h4>Contact</h4>
        <a href="https://wa.me/243858814961" target="_blank" rel="noopener">WhatsApp</a>
        <a href="mailto:contact@lumu.cd">contact@lumu.cd</a>
        <span>Kinshasa, RDC</span>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© 2026 LUMU. Tous droits réservés.</p>
      <p>Conçu à Kinshasa 🇨🇩</p>
    </div>
  </div>
</footer>
<!-- Bouton WhatsApp flottant -->
<a
  href="https://wa.me/243858814961"
  class="whatsapp-float"
  target="_blank"
  rel="noopener"
  data-cursor-text="WhatsApp"
  aria-label="Contacter LUMU sur WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.893c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.445h.006c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.41z"/>
  </svg>
  <span class="whatsapp-float__pulse"></span>
</a>
  </main>
</BaseLayout>