---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';

const API_URL = import.meta.env.PUBLIC_LUMU_API_URL;
---

<BaseLayout
  title="Suivi de colis — LUMU"
  description="Suivez votre colis LUMU en temps réel. Entrez votre numéro de suivi pour connaître le statut de votre livraison à Kinshasa."
>
  <Navbar />

  <main class="tracking-page">
    <section class="section tracking-hero">
      <div class="container">
        <span class="section-label">Suivi de colis</span>
        <h1>Où est mon colis<span class="dot">?</span></h1>
        <p class="section-intro">
          Entrez votre numéro de suivi LUMU pour connaître le statut de votre livraison en temps réel.
        </p>

        <form class="tracking-form" id="tracking-form" novalidate>
          <div class="tracking-form__field">
            <input
              type="text"
              id="tracking-input"
              placeholder="LUMU-2026-0001"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="submit" class="btn btn-primary tracking-form__submit" data-cursor-text="Suivre">
              Suivre
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
          <p class="tracking-form__hint">
            Le numéro commence par <strong>LUMU-</strong> suivi de l'année et d'un compteur.
          </p>
        </form>
      </div>
    </section>

    <!-- Zone de résultat -->
    <section class="section tracking-result" id="tracking-result" hidden>
      <div class="container">

        <!-- État : chargement -->
        <div class="tracking-state" id="tracking-loading" hidden>
          <div class="tracking-loading__spinner"></div>
          <p>Recherche de votre colis<span class="dot">.</span></p>
        </div>

        <!-- État : erreur -->
        <div class="tracking-state tracking-state--error" id="tracking-error" hidden>
          <div class="tracking-error__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <h3 id="tracking-error-title">Numéro introuvable</h3>
          <p id="tracking-error-message">
            Vérifiez le numéro et réessayez, ou contactez-nous sur WhatsApp.
          </p>
          <a href="https://wa.me/243858814961" target="_blank" rel="noopener" class="btn btn-outline">
            Contacter LUMU
          </a>
        </div>

        <!-- État : succès -->
        <div class="tracking-state tracking-state--success" id="tracking-success" hidden>
          <div class="tracking-summary">
            <div class="tracking-summary__left">
              <span class="tracking-summary__label">Colis</span>
              <div class="tracking-summary__numero" id="tracking-numero">LUMU-2026-0001</div>
              <div class="tracking-summary__client">
                Destinataire : <span id="tracking-client">—</span>
              </div>
            </div>
            <div class="tracking-summary__right">
              <span class="tracking-summary__label">Statut actuel</span>
              <div class="tracking-badge" id="tracking-badge" data-statut="pending">
                <span class="tracking-badge__icon" id="tracking-badge-icon"></span>
                <span class="tracking-badge__text" id="tracking-badge-text">—</span>
              </div>
            </div>
          </div>
          <div class="tracking-actions">
  <button type="button" class="btn btn-outline tracking-copy" id="tracking-copy" data-cursor-text="Copier">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
    </svg>
    <span id="tracking-copy-label">Copier le lien de suivi</span>
  </button>
  <a
    href="#"
    class="btn btn-outline tracking-whatsapp"
    id="tracking-whatsapp"
    target="_blank"
    rel="noopener"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    </svg>
    Partager sur WhatsApp
  </a>
</div>

          <div class="tracking-timeline">
            <h3 class="tracking-timeline__title">Historique</h3>
            <ol class="tracking-timeline__list" id="tracking-timeline-list">
              <!-- Rempli en JS -->
            </ol>
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- Données pour le script -->
  <script define:vars={{ API_URL }}>
  window.LUMU_API_URL = API_URL;
</script>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import '../scripts/lenis.js';
  import { initCursor } from '../scripts/cursor.js';
  import { initTracking } from '../scripts/tracking.js';

  gsap.registerPlugin(ScrollTrigger);

  // Connexion Lenis × GSAP
  const lenis = window.lenis;
  if (lenis) {
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initCursor();
    initTracking();
  });
</script>
</BaseLayout>