---
// Navbar globale LUMU — réutilisable sur toutes les pages
// Détecte automatiquement la page active

const currentPath = Astro.url.pathname;

const links = [
  { href: '/#services', label: 'Services', match: '/' },
  { href: '/#process', label: 'Fonctionnement', match: '/' },
  { href: '/#zones', label: 'Zones', match: '/' },
  { href: '/suivi', label: 'Suivi', match: '/suivi' },
  { href: '/#contact', label: 'Contact', match: '/' },
];

const isActive = (link) => {
  if (link.href === '/suivi') return currentPath === '/suivi';
  return currentPath === '/';
};
---

<header id="navbar" class="navbar">
  <div class="container navbar__inner">
    <a href="/" class="navbar__logo">LUMU<span class="dot">.</span></a>

    <nav class="navbar__links">
      {links.map((link) => (
        <a
          href={link.href}
          class={link.href === '/suivi' && isActive(link) ? 'is-active' : ''}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="navbar__right">
      <button class="theme-toggle" id="theme-toggle" aria-label="Changer de thème">
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a href="/#contact" class="btn btn-primary navbar__cta" data-cursor-text="Devis">Devis</a>

      <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- MENU MOBILE -->
<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-menu__nav">
    {links.map((link) => (
      <a href={link.href} data-menu-link>{link.label}</a>
    ))}
  </nav>

  <div class="mobile-menu__footer">
    <a href="https://wa.me/243822294344" target="_blank" rel="noopener" class="btn btn-primary">
      WhatsApp
    </a>
    <button class="theme-toggle theme-toggle--mobile" id="theme-toggle-mobile" aria-label="Changer de thème">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</div>